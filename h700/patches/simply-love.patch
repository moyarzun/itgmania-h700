diff --git a/Scripts/SL-DeviceLayout.lua b/Scripts/SL-DeviceLayout.lua
new file mode 100644
index 0000000..46ebef8
--- /dev/null
+++ b/Scripts/SL-DeviceLayout.lua
@@ -0,0 +1,43 @@
+-- Device port layout constants for ScreenSelectMusic (handheld, 16:9 theme
+-- space of ~854x480).  The left column (banner, song info, density graph,
+-- difficulty grid, pane) is scaled by LeftZoom; the MusicWheel fills the rest
+-- of the screen at WheelZoom with its items narrowed to WheelItemWidth so the
+-- zoomed wheel ends exactly at the right edge.
+SL_DEVICE = {
+	LeftZoom = 1.3,
+	-- local x-range of the left column's content (banner/description/graph/grid)
+	LeftMinX = _screen.cx - 330,
+	LeftMaxX = _screen.cx - 10,
+	LeftScreenX = 6,
+	WheelZoom = 1.5,
+	-- room right of the difficulty grid for the mirrored difficulty cursor
+	WheelGap = 32,
+	-- song title x inside a MusicWheelItem (stock 111; grade lamp sits at ~50)
+	WheelTitleX = 80,
+}
+local d = SL_DEVICE
+d.LeftGroupX = d.LeftScreenX - d.LeftZoom * d.LeftMinX
+d.WheelLeft = d.LeftGroupX + d.LeftZoom * d.LeftMaxX + d.WheelGap
+-- MusicWheelItems start 33px right of the wheel's origin (WideScale(28,33))
+d.WheelX = d.WheelLeft - d.WheelZoom * 33
+d.WheelItemWidth = (_screen.w - d.WheelX) / d.WheelZoom - 33
+d.WheelItemRight = 33 + d.WheelItemWidth
+
+-- ScreenGameplay Step Statistics pane (single player, centered notefield):
+-- StepStatistics/default.lua fills SL_DEVICE.StepStats with the pane's origin
+-- and the BannerAndData zoom; pieces use these helpers to place themselves at
+-- absolute screen positions instead of the stock right-side column.
+SL_DEVICE.StepStats = { active = false, x = 0, y = 0, zoom = 1 }
+-- vertical center shared by the left (banner + density graph) and right
+-- (judgments + holds/mines/rolls) columns: middle of the free area between
+-- the header (~80) and the profile name at the bottom (~455)
+SL_DEVICE.GameplayCenterY = 267
+-- left column block: banner (106) + gap (20) + Peak NPS label (18) + graph (70)
+SL_DEVICE.GameplayLeftTop = SL_DEVICE.GameplayCenterY - 107
+-- right column block's stock vertical center is ~218.5
+SL_DEVICE.GameplayRightShift = SL_DEVICE.GameplayCenterY - 218.5
+-- screen point -> local point inside the (zoomed) BannerAndData frame
+SL_DEVICE.SSLocal = function(sx, sy)
+	local s = SL_DEVICE.StepStats
+	return (sx - s.x) / s.zoom, (sy - s.y) / s.zoom
+end
