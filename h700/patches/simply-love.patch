diff --git a/BGAnimations/ScreenGameplay underlay/PerPlayer/StepStatistics/RoundedBox.lua b/BGAnimations/ScreenGameplay underlay/PerPlayer/StepStatistics/RoundedBox.lua
new file mode 100644
index 0000000..26326c5
--- /dev/null
+++ b/BGAnimations/ScreenGameplay underlay/PerPlayer/StepStatistics/RoundedBox.lua	
@@ -0,0 +1,33 @@
+-- device port: translucent black box with rounded corners, drawn as a single
+-- triangle fan (so the alpha is uniform -- overlapping quads would double it).
+-- args: { left, top, right, bottom, radius, alpha } in the parent's coordinates
+local l, t, r, b, rad, alpha = unpack(...)
+local segments = 6
+local color = {0, 0, 0, alpha}
+
+local cx, cy = (l + r) / 2, (t + b) / 2
+local verts = { {{cx, cy, 0}, color} }
+
+-- corner centers and their start angles, walking the perimeter clockwise
+local corners = {
+	{ r - rad, t + rad, -90 }, -- top-right
+	{ r - rad, b - rad,   0 }, -- bottom-right
+	{ l + rad, b - rad,  90 }, -- bottom-left
+	{ l + rad, t + rad, 180 }, -- top-left
+}
+for c in ivalues(corners) do
+	for i = 0, segments do
+		local a = math.rad(c[3] + 90 * i / segments)
+		verts[#verts+1] = { {c[1] + rad * math.cos(a), c[2] + rad * math.sin(a), 0}, color }
+	end
+end
+-- close the fan
+verts[#verts+1] = verts[2]
+
+return Def.ActorMultiVertex{
+	Name="JudgmentsBox",
+	InitCommand=function(self)
+		self:SetDrawState{ Mode="DrawMode_Fan" }
+		self:SetVertices(verts)
+	end
+}
