+-- device port: judgments + holds/mines/rolls are scaled up by JudgScale and laid
+-- out as 9 evenly spaced rows (6 judgments, 3 HMR) vertically centered on
+-- GameplayCenterY, right edge 60px from the screen edge, with a rounded
+-- translucent box behind them.  Screen coordinates, converted to pane coords.
+if SL_DEVICE.StepStats.active then
+	local s = SL_DEVICE.StepStats
+	local k = 1.3
+	SL_DEVICE.JudgScale = k
+	-- judgment rows are 35 apart inside a 0.8-zoomed frame (HMR: 28 at zoom 1)
+	SL_DEVICE.JudgRow = s.zoom * 0.8 * k * 35
+	SL_DEVICE.JudgFirstY = SL_DEVICE.GameplayCenterY - 4 * SL_DEVICE.JudgRow
+
+	-- two identical boxes, each centered in its own third of the screen (the
+	-- strips left and right of the centered notefield):
+	-- right = judgments + HMR, left = banner + density graph
+	local box_w, pad = 240, 12
+	local nf_half = GetNotefieldWidth() / 2
+	local top    = SL_DEVICE.JudgFirstY - 12 - pad
+	local bottom = SL_DEVICE.JudgFirstY + 8 * SL_DEVICE.JudgRow + 12 + pad
+	local rl = (_screen.cx + nf_half + _screen.w) / 2 - box_w/2 -- right box, left edge
+	local ll = (_screen.cx - nf_half) / 2 - box_w/2             -- left box, left edge
+
+	-- right box: the judgments block (~131px wide at scale 1, right-aligned
+	-- at JudgRight) centered horizontally inside it
+	SL_DEVICE.JudgRight = rl + box_w/2 + 131 * k / 2
+
+	-- left box: banner (full inner width) and the density graph + its Peak NPS
+	-- label (18px + 2), with equal space above, between, and below them
+	local inner_w = box_w - pad * 2
+	SL_DEVICE.LeftInnerX = ll + pad
+	SL_DEVICE.GraphW, SL_DEVICE.GraphH = inner_w, 100
+	SL_DEVICE.BannerW = inner_w
+	local banner_h = inner_w * 164 / 418
+	local g = ((bottom - top) - banner_h - 20 - SL_DEVICE.GraphH) / 3
+	SL_DEVICE.BannerCenter = { ll + box_w/2, top + g + banner_h/2 }
+	SL_DEVICE.GraphTop = bottom - g - SL_DEVICE.GraphH
+
+	for l in ivalues({ rl, ll }) do
+		af[#af+1] = LoadActor("./RoundedBox.lua", {
+			l - s.x, top - s.y, l + box_w - s.x, bottom - s.y, 10, 0.65
+		})
+	end
+end
