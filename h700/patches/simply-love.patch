+-- Button icons left of the special keys, for the Shortcut* buttons in
+-- metrics.ini [ScreenTextEntry]. Joystick button numbers are the built-in
+-- pad's (see Keymaps.ini), whose face buttons are in the Nintendo layout.
+local buttonNames = { B1="A", B2="B", B4="X", B5="Y", B11="SELECT", B12="START" }
+-- columns of the special keys in the engine's "qwerty" layout
+-- (g_KeyboardLayouts in ScreenTextEntry.cpp)
+local specialCols = { Shift=0, Space=3, Backspace=6, Cancel=9, Done=12 }
+local rowStartX = THEME:GetMetric("ScreenTextEntry", "RowStartX")
+local rowEndX = THEME:GetMetric("ScreenTextEntry", "RowEndX")
+local rowEndY = THEME:GetMetric("ScreenTextEntry", "RowEndY")
+local iconH = 24
+local gap = 6
+
+-- rounded rectangle centered on 0,0 as one triangle fan; a circle when w == h
+local function PillVerts(w, h)
+	local rad, segments, verts = h/2, 8, { {{0, 0, 0}, Color.White} }
+	for c in ivalues({ {w/2-rad, -90}, {-(w/2-rad), 90} }) do
+		for i = 0, segments do
+			local a = math.rad(c[2] + 180 * i / segments)
+			verts[#verts+1] = { {c[1] + rad*math.cos(a), rad*math.sin(a), 0}, Color.White }
+		end
+	end
+	verts[#verts+1] = verts[2]
+	return verts
+end
+
+for key, col in pairs(specialCols) do
+	local name = buttonNames[THEME:GetMetric("ScreenTextEntry", "Shortcut"..key)]
+	if name then
