+			OnCommand=function(self)
+				local label = self:GetChild("Label"):GetZoomedWidth()
+				local text = self:GetChild("Text")
+				local w = math.max(iconH, text:GetZoomedWidth() + 12)
+				self:GetChild("Icon"):SetVertices(PillVerts(w, iconH))
+				self:xy(scale(col, 0, 12, rowStartX, rowEndX) - label/2 - gap - w/2, rowEndY)
+			end,
+			-- invisible copy of the key's label, to measure it
+			Def.BitmapText{
+				Name="Label", Font="ScreenTextEntry keyboard",
+				Text=THEME:GetString("ScreenTextEntry", key),
+				InitCommand=function(self)
+					THEME:GetMetric("ScreenTextEntry", "KeysInitCommand")(self)
+					self:visible(false)
+				end
+			},
+			Def.ActorMultiVertex{
+				Name="Icon",
+				InitCommand=function(self) self:SetDrawState{ Mode="DrawMode_Fan" } end
+			},
+			Def.BitmapText{
+				Name="Text", Font="Common Normal", Text=name,
+				InitCommand=function(self) self:zoom(#name > 1 and 0.7 or 0.95):diffuse(Color.Black) end
+			}
+		}
+	end
+end
 
