+-- Solid backdrop behind the on-screen keyboard (ScreenTextEntryVisual), sized
+-- from the same RowStartX/RowEndX/RowStartY/RowEndY metrics the C++ side uses
+-- to lay out the keys (see metrics.ini [ScreenTextEntry]), plus a margin.
+local kbLeft = SCREEN_LEFT+100
+local kbRight = SCREEN_RIGHT-100
+local kbTop = SCREEN_CENTER_Y-36
+local kbBottom = SCREEN_CENTER_Y+164
+-- wide enough for the button icon left of Shift (below)
+local kbMarginX = 64
+local kbMarginY = 26
+local kbCenterX = (kbLeft+kbRight)/2
+local kbCenterY = (kbTop+kbBottom)/2
+local kbWidth = (kbRight-kbLeft)+kbMarginX*2
+local kbHeight = (kbBottom-kbTop)+kbMarginY*2
+
+af[#af+1] = Def.Quad {
+	InitCommand=function(self) self:xy(kbCenterX, kbCenterY):zoomto(kbWidth, kbHeight):diffuse(0,0,0,0.9) end
 }
